FROM node:22-bookworm
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY angular.json tsconfig.json tsconfig.app.json tsconfig.spec.json ./
COPY public ./public
COPY src ./src

# Watch-build into the volume that Express mounts as /app/public.
CMD ["npx", "ng", "build", "--watch", "--output-path=/out"]
