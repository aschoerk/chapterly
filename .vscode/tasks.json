          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "type": "npm",
      "script": "test",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "label": "chapterly-sqlite: docker compose up",
      "type": "shell",
      "command": "docker compose -f docker-compose.chapterly-sqlite.yml up",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "chapterly-sqlite: docker compose up -d",
      "type": "shell",
      "command": "docker compose -f docker-compose.chapterly-sqlite.yml up -d",
      "problemMatcher": []
