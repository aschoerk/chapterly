@startuml usecase-11-send-rewrite
!theme plain
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam wrapWidth 170
title Use case 11 — send-rewrite (regenerate in place)\n"delete ONLY the answer (keep following text), re-stream and re-adopt the preserved children"

actor User
participant "ChatNodeComponent\nregenerateInPlace()" as UI
participant "LlmFlowRunner\n(env)" as RUN
participant "sendRewrite\n(controller)" as UC
participant "prepareTextSend\n(shared rule)" as PREP
participant "streamAnswerNode\n(shared)" as STRM
participant "LlmOrchestratorService" as ORCH
participant "LlmTransportService" as XPORT
participant "ChatService" as SVC
participant "Provider\n(proxy SSE)" as NET

== 1. Confirm + flow runner ==
User -> UI : Regenerate in place (on an assistant answer)
UI -> UI : confirm (following text will be preserved)
UI -> RUN : runFlow('send-rewrite') — node = the ANSWER
RUN --> UC : sendRewrite(env)

== 2. Delete ONLY the answer (keep children) ==
UC -> SVC : adoptNodeIds = getChildren(node.id).map(c => c.id)
UC -> SVC : deleteNode(chat, node.id, { keepChildren: true })
SVC --> UC : children stay, re-parented to the question

== 3. Prepare (interpret-if-needed on the QUESTION) ==
UC -> PREP : prepareTextSend(env, chat, question, { content, attachments })
PREP --> UC : messages

== 4. Stream a fresh answer that re-adopts the children ==
UC -> STRM : streamAnswerNode(env, chat, question.id, messages,\n{ adoptNodeIds })
STRM -> SVC : addNode(assistant) + startGeneration
STRM -> ORCH : completion(stream) — SSE, live paint
ORCH -> XPORT : complete()
XPORT -> NET : POST SSE
XPORT --> ORCH : final
ORCH --> STRM : answerNodeId (versioned) + slots
STRM --> UC : answerNodeId (versioned) + slots
STRM -> SVC : reparent(adoptNodeIds → answerNodeId)\nsetActiveChild(answer → firstAdopt)

== 5. Result ==
UC -> UI : flow slot { questionNodeId, answerNodeId, activateId }\nactivate(question.id)

@enduml