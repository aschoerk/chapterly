@startuml usecase-03-planned-scenes
!theme plain
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam wrapWidth 170
title Use case 3 — planned-scenes\n"text model derives PICTURE DESCRIPTIONS ONLY,\nthen render them ONE PER SCENE in a loop"

actor User
participant "IllustrateDialog" as DLG
participant "ChatNodeComponent\nillustrate()" as UI
participant "LlmUseCaseRunner\n(env)" as RUN
participant "plannedScenes\n(controller)" as UC
participant "planStoryboardDescriptions\n(shared)" as PLAN
participant "LlmOrchestratorService" as ORCH
participant "LlmTransportService" as XPORT
participant "Evaluators" as EVAL
participant "LlmLogService" as LOG
participant "LlmPostprocessorService" as POST
participant "ChatService" as SVC
participant "Provider\n(proxy)" as NET

== 1. Dialog picks the use case ==
User -> DLG : count(>1), planning ON, NOT singleCall/enblock\n+ style, storyboard rules
DLG --> UI : options
UI -> UI : pickUsecase(vars) → 'planned-scenes'

== 2. Run: env ==
UI -> RUN : runner.run(chat, node, 'planned-scenes', vars)
RUN -> RUN : render + plan model resolution\n(contextMessages, anchor, imageExtras)
RUN --> UC : controllerFor('planned-scenes')(env)

== 3. Step 1 — planning (IDENTICAL to use case 2) ==
UC -> PLAN : runPlanning(env)
PLAN -> ORCH : completion(plan model, expect:'descriptions')
ORCH -> XPORT : complete()
XPORT -> NET : POST /chat/completions (text)
XPORT --> ORCH : raw
ORCH -> EVAL : evaluateDescriptions(raw)
EVAL --> ORCH : descriptions slot
ORCH --> PLAN : descriptions[]
PLAN --> UC : descriptions[]

== 4. Step 2 — per-scene LOOP (independent slots) ==
loop i in 0..count-1  (stop when signal aborted)
  UC -> UC : prompt = anchor + "Render exactly: desc[i]"\n(or storyboardInstruction fallback)\nscene = i+1
  UC -> ORCH : completeImage(request, expect:'images', scene:i+1, signal)
  ORCH -> XPORT : completeImage()
  XPORT -> NET : POST /chat/completions (per scene)
  XPORT --> ORCH : raw (or thrown TransportError)
  ORCH -> EVAL : evaluateImagesResponse({raw} or {error, aborted})
  EVAL --> ORCH : scene[i] slot (ok | refused | error, reason)
  ORCH --> UC : scene[i]
  note over UC, EVAL
    A refused/moderated scene records as refused and\nNEVER discards previously collected images —\nthe loop continues with the next scene.\nAbort/timeout in a child stops the whole tree.
  end note
  UC -> UC : collected += images; scenes.push({scene, prompt, images, refused})
end

== 5. Place (partial results preserved) ==
UC -> POST : storyboard slot = all scenes (some may be refused)\nimages slot = collected images
POST -> SVC : editAssistant(chapter,\nillustration-N + prompt-N / refused-prompt-N)
POST --> UI : activate(chapter.id)\nalert if partial/empty

@enduml